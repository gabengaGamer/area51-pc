{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs2022-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "A51_BUILD_SELECTED_APPS": "ON"
      }
    },
    {
      "name": "windows-vs2022-win32",
      "inherits": "windows-vs2022-base",
      "displayName": "Windows MSVC Win32 / Visual Studio 2022",
      "description": "32-bit x86 multi-configuration MSVC build for Windows.",
      "architecture": "Win32"
    },
    {
      "name": "windows-vs2022-x64",
      "inherits": "windows-vs2022-base",
      "displayName": "Windows MSVC x64 / Visual Studio 2022",
      "description": "64-bit x64 multi-configuration MSVC build for Windows.",
      "architecture": "x64"
    },
    {
      "name": "windows-vs2022-arm",
      "inherits": "windows-vs2022-base",
      "displayName": "Windows MSVC ARM32 / Visual Studio 2022",
      "description": "32-bit ARM multi-configuration MSVC build for Windows.",
      "architecture": "ARM"
    },
    {
      "name": "windows-vs2022-arm64",
      "inherits": "windows-vs2022-base",
      "displayName": "Windows MSVC ARM64 / Visual Studio 2022",
      "description": "64-bit ARM multi-configuration MSVC build for Windows.",
      "architecture": "ARM64"
    },
    {
      "name": "ninja-multi",
      "displayName": "Ninja Multi-Config / host compiler",
      "description": "Multi-configuration Ninja build using the host compiler.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "A51_BUILD_SELECTED_APPS": "ON"
      }
    },
    {
      "name": "linux-gcc-x64",
      "displayName": "Linux GCC x64 portability baseline",
      "description": "Linux x64 multi-configuration portability baseline; the toolchain supplies the compiler.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux.cmake",
      "cacheVariables": {
        "A51_BUILD_SELECTED_APPS": "ON",
        "A51_BUILD_WINDOWS_TARGETS": "OFF",
        "A51_ENABLE_QT": "OFF"
      }
    },
    {
      "name": "linux-gcc-x86",
      "displayName": "Linux GCC x86 portability baseline",
      "description": "32-bit x86 Linux multi-configuration build using an i686 cross compiler.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x86.cmake",
      "cacheVariables": {
        "A51_BUILD_SELECTED_APPS": "ON",
        "A51_BUILD_WINDOWS_TARGETS": "OFF",
        "A51_ENABLE_QT": "OFF"
      }
    },
    {
      "name": "linux-gcc-arm32",
      "displayName": "Linux GCC ARM32 portability baseline",
      "description": "32-bit ARM Linux multi-configuration build using an arm-linux-gnueabihf cross compiler.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm.cmake",
      "cacheVariables": {
        "A51_BUILD_SELECTED_APPS": "ON",
        "A51_BUILD_WINDOWS_TARGETS": "OFF",
        "A51_ENABLE_QT": "OFF"
      }
    },
    {
      "name": "linux-gcc-arm64",
      "displayName": "Linux GCC ARM64 portability baseline",
      "description": "64-bit ARM Linux multi-configuration build using an aarch64 cross compiler.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm64.cmake",
      "cacheVariables": {
        "A51_BUILD_SELECTED_APPS": "ON",
        "A51_BUILD_WINDOWS_TARGETS": "OFF",
        "A51_ENABLE_QT": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "selected-apps",
      "hidden": true,
      "description": "Build the game application and its dependencies.",
      "targets": [
        "A51"
      ]
    },
    {
      "name": "all-apps",
      "hidden": true,
      "description": "Build all configured application targets.",
      "targets": [
        "a51_selected_apps"
      ]
    },
    {
      "name": "all-tools",
      "hidden": true,
      "description": "Build all configured tool targets.",
      "targets": [
        "a51_tools"
      ]
    },

    {
      "name": "windows-vs2022-win32-debug",
      "inherits": "selected-apps",
      "configurePreset": "windows-vs2022-win32",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2022-win32-optdebug",
